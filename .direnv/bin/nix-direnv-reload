#!/usr/bin/env bash
set -e
if [[ ! -d "/home/wouter/Projects/M0TH3RAT3" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/home/wouter/Projects/M0TH3RAT3")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/home/wouter/Projects/M0TH3RAT3" true
